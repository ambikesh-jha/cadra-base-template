# HTTP server
PORT=8000

# Writable SQLite location. Leave unset to use /tmp/larkfield/runs.db
RUN_DB_PATH=runs.db

# Optional LLM layer. Leave unset to use the deterministic regex/template fallback.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT=5

# Token prices in USD per 1,000 tokens, used to compute measured cost_usd.
LLM_INPUT_USD_PER_1K=0
LLM_OUTPUT_USD_PER_1K=0
